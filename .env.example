# Copie para .env e preencha. Nao commite o .env.

DB_USERNAME=auth
DB_PASSWORD=authpass
DB_DATABASE=auth_service_db
MASTER_KEY=local-master-key-change-me

FLAG_DB_USERNAME=flag
FLAG_DB_PASSWORD=flagpass
FLAG_DB_DATABASE=flag_service_db

TARGETING_DB_USERNAME=targeting
TARGETING_DB_PASSWORD=targetingpass
TARGETING_DB_DATABASE=targeting_service_db

AUTH_SERVICE_URL=http://auth-service:8001/auth
FLAG_SERVICE_URL=http://flag-service:8002
TARGETING_SERVICE_URL=http://targeting-service:8003/targeting
REDIS_URL=redis://redis:6379

# Gere depois que o auth-service estiver no ar (veja docs/01-GUIA-LOCAL.md)
SERVICE_API_KEY=

# So precisos se quiser testar evaluation -> SQS -> analytics localmente
AWS_REGION=us-east-2
AWS_SQS_URL=
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
